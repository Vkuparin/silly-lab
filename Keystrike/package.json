{
  "name": "keystrike",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1430 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "check": "npm test && npm run build",
    "smoke": "node scripts/smoke.mjs",
    "notices": "node scripts/notices.mjs",
    "native:smoke": "node scripts/native-smoke.mjs",
    "format": "prettier --write src test scripts/*.mjs *.json vite.config.ts index.html src-tauri/tauri.conf.json src-tauri/capabilities/default.json",
    "format:check": "prettier --check src test scripts/*.mjs *.json vite.config.ts index.html src-tauri/tauri.conf.json src-tauri/capabilities/default.json",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1",
    "smoke:iteration": "node scripts/iteration-smoke.mjs",
    "native:iteration": "node scripts/native-iteration-smoke.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vite": "8.3.1"
  }
}
