{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keystrike",
  "version": "1.0.0",
  "identifier": "fi.vkuparin.keystrike",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Keystrike / Näppäinisku",
        "width": 1200,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 768
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; media-src 'self' blob:"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
